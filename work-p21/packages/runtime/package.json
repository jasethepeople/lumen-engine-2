{
  "name": "@lumen/runtime",
  "version": "0.1.0",
  "description": "Lumen engine browser runtime: boots generated SceneIR into a live kernel/scene/renderer loop. Thin orchestration glue over the module packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lumen/contracts": "*",
    "@lumen/kernel": "*",
    "@lumen/scene": "*",
    "@lumen/rendering": "*",
    "@lumen/assets": "*",
    "@lumen/interaction": "*"
  },
  "license": "UNLICENSED"
}
