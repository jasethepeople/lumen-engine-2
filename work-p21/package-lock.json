{
  "name": "lumen-engine",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lumen-engine",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "contracts",
        "examples/*"
      ],
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "contracts": {
      "name": "@lumen/contracts",
      "version": "0.1.0",
      "license": "UNLICENSED"
    },
    "node_modules/@lumen/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@lumen/contracts": {
      "resolved": "contracts",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://npm.mirrors.msh.team/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/config": {
      "name": "@lumen/config",
      "version": "0.1.0",
      "dependencies": {
        "@lumen/contracts": "0.1.0"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    }
  }
}
