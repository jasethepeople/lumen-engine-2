{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lumen/contracts": ["../../contracts/dist/index.d.ts"],
      "@lumen/kernel": ["../../packages/kernel/dist/index.d.ts"],
      "@lumen/scene": ["../../packages/scene/dist/index.d.ts"],
      "@lumen/rendering": ["../../packages/rendering/dist/index.d.ts"],
      "@lumen/assets": ["../../packages/assets/dist/index.d.ts"],
      "@lumen/interaction": ["../../packages/interaction/dist/index.d.ts"],
      "@lumen/config": ["../../packages/config/dist/index.d.ts"],
      "@lumen/templates": ["../../packages/templates/dist/index.d.ts"],
      "@lumen/codegen": ["../../packages/codegen/dist/index.d.ts"],
      "@lumen/runtime": ["../../packages/runtime/dist/index.d.ts"],
      "@lumen/app-runtime": ["./src/lumen/app-runtime-fallback.ts"],
      "@lumen/app-projects": ["../../app/projects/dist/index.d.ts"],
      "@lumen/app-settings": ["../../app/settings/dist/index.d.ts"],
      "@lumen/app-telemetry": ["../../app/telemetry/dist/index.d.ts"],
      "@lumen/app-billing": ["../../app/billing/dist/index.d.ts"],
      "@lumen/app-entitlements": ["../../app/entitlements/dist/index.d.ts"],
      "@lumen/app-marketplace": ["../../app/marketplace/dist/index.d.ts"],
      "@lumen/app-assets": ["../../app/assets/dist/index.d.ts"],
      "@lumen/app-publish": ["../../app/publish/dist/index.d.ts"],
      "@lumen/app-onboarding": ["../../app/onboarding/dist/index.d.ts"],
      "@lumen/build": ["../../packages/build/dist/index.d.ts"],
      "@lumen/app-collaboration": ["../../app/collaboration/dist/index.d.ts"],
      "@lumen/app-ai": ["../../app/ai/dist/index.d.ts"],
      "@lumen/app-designer": ["../../app/designer/dist/index.d.ts"],
      "@lumen/app-dashboard": ["../../app/dashboard/dist/index.d.ts"],
      "@lumen/app-community": ["../../app/community/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
