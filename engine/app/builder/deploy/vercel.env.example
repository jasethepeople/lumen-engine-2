# Vercel environment variables — corrected mapping
# Vite exposes only VITE_* vars to the browser bundle. Serverless routes
# under api/ can read all vars (including server-only ones).

# --- Browser-exposed (safe) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...        # anon public key
VITE_PUBLISH_PIPELINE_URL=/api/publish    # goes through the Vercel proxy
VITE_ASSET_PIPELINE_URL=/api/assets       # goes through the Vercel proxy

# --- Server-only (NEVER VITE_/NEXT_PUBLIC_ prefixed) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...    # legacy service_role JWT
CRON_SECRET=<same value as Supabase secret>
SUPABASE_FUNCTION_BASE=https://<project-ref>.supabase.co  # optional override

# --- Compatibility aliases (only if something reads NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
