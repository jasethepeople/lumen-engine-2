{
  "name": "@lumen/assets",
  "version": "0.1.0",
  "description": "Lumen engine asset pipeline: manifest handling, priority preloading, caching, and per-kind loaders.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/"
  },
  "dependencies": {
    "@lumen/contracts": "*"
  },
  "keywords": [
    "lumen",
    "assets",
    "preloading",
    "cache"
  ],
  "license": "UNLICENSED"
}
