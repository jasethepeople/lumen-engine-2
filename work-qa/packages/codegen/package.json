{
  "name": "@lumen/codegen",
  "version": "0.1.0",
  "type": "module",
  "description": "Lumen engine \u2014 config + composed scene to code/bundle generation (static, webcomponent, npm, runtime targets).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/"
  },
  "dependencies": {
    "@lumen/contracts": "0.1.0",
    "@lumen/templates": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "license": "UNLICENSED"
}
