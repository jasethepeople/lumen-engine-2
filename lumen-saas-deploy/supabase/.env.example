# Supabase side — copy to .env, never commit real values.
# All values: Supabase Dashboard → Project Settings → API.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key (eyJ… JWT) — safe for browser exposure
SUPABASE_ANON_KEY=eyJhbGciOi...

# LEGACY service_role JWT (eyJ…). Server-only. Do NOT use the new
# sb_secret_… key format — it fails the platform JWT layer.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Only needed for local JWT debugging
SUPABASE_JWT_SECRET=

# Edge-function secrets (also set via deploy-supabase.sh)
CRON_SECRET=64-hex-chars
PAYOUT_THRESHOLD_CENTS=2500
